    <dsc><c01 id="aspace_cfeda43d42f2ac548eddac3088ddd75d" level="series"><did><unittitle>Correspondence</unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/190248</unitid></did><scopecontent><p>The Correspondence series includes letters from fellow members of Congress, cabinet officers, Michigan political figures and some constituent mail. The correspondence is arranged chronologically. A select index to correspondents lists letters from some of the more prominent individuals represented in the series.</p></scopecontent><c02 id="aspace_5271a8c22fcd043d70dfe239514217b8" level="file"><did><unitid type="aspace_uri">/repositories/2/archival_objects/190253</unitid><physdesc><extent>25 folders</extent></physdesc><unitdate calendar="gregorian" datechar="creation" era="ce" type="inclusive">Undated</unitdate><unitdate datechar="creation" normal="1911/1948" type="inclusive">1911-1948</unitdate><container label="Box" type="box">1</container></did><odd><p>(Folder "Correspondence, 1940" included a letter dated March 21, 1940, typed on the Walt Disney's Pinocchio letterhead, and signed by Walt Disney. The letter has been moved to the vault. It is open for research.)</p></odd></c02><c02 id="aspace_5fbd7e03e413974618c9337310b0a2ea" level="file"><did><unittitle>Walt Disney letter</unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/1032293</unitid><container label="Folder" type="folder">1</container></did><odd><p>(Vault)</p></odd></c02><c02 id="aspace_90934948d20272521102d97caad94747" level="file"><did><unitid type="aspace_uri">/repositories/2/archival_objects/190254</unitid><physdesc><extent>10 folders</extent></physdesc><unitdate datechar="creation" normal="1949/1960" type="inclusive">1949-1960</unitdate><container label="Box" type="box">2</container></did></c02><c02 id="aspace_4b65af554e8b6633dd789617306752cb" level="file"><did><unittitle>Re A.J. Engel Oil Co.</unittitle><unitid type="aspace_uri">/repositories/2/archival_objects/190255</unitid>